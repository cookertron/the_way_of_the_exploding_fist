# tape-derived material never goes in a public repository
tape/
*.tzx
*.tap
*.pkl
build/*.bin
build/*.pkl
# local probe output
*.ppm
shot*.png
# python / node
__pycache__/
*.pyc
node_modules/
# snapshots are tape-derived too
*.z80
*.szx
*.sna
# scratch space: cleared at unit end; status.py warns about anything that survives a commit
scratch/
# personal session files, not project records
claude-resume.txt
# the mutation runner's local state: last verdicts, cache, summary
build/mutants/
# the built page: it inlines tape-derived assets (rule 7)
web/fist.html
